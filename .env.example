# Facultatif en dev : docker-compose.yml a des valeurs par défaut pour tout.
# Obligatoire sur la VM : copier ce fichier en .env (jamais commité) et remplir.
# Mots de passe : lettres et chiffres uniquement (ils sont insérés dans des URL).
#
# Générer un secret :
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- PostgreSQL (défaut : gazette / airflow) ---
# GAZETTE_DB_PASSWORD=
# AIRFLOW_DB_PASSWORD=

# --- Airflow ---
# Secret partagé par l'api-server et le scheduler.
# AIRFLOW_JWT_SECRET=
# Clé Fernet pour chiffrer les connexions enregistrées dans Airflow :
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# AIRFLOW_FERNET_KEY=
# Compte de l'UI, créé au premier démarrage (défaut : admin / admin).
# AIRFLOW_ADMIN_USER=admin
# AIRFLOW_ADMIN_PASSWORD=

# --- Collecte ---
# User-Agent identifié envoyé aux éditeurs (docs/cadrage.md, contraintes).
# GAZETTE_USER_AGENT=LaGazette/0.1 (projet etudiant; contact: adresse-de-l-equipe)

# --- Ports sur la machine hôte (si un port est déjà pris) ---
# AIRFLOW_PORT=8080
# EDITIONS_PORT=8000
# POSTGRES_PORT=5432
